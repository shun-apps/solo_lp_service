{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atelier-customer-CHANGE-ME",
  "main": "./delivery/worker.mjs",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "assets": {
    "directory": "./dist-delivery",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atelier-customer-CHANGE-ME",
      "database_id": "CHANGE-TO-CUSTOMER-DB-ID"
    }
  ]
}
